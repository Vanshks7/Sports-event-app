# ==============================================================================
# Community Multisports Portal — Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Options:
# 1. PostgreSQL (Production): postgresql://postgres:password@localhost:5432/jito_multisports
# 2. SQLite (Local / Development): Leave unset or use sqlite:./server/database/community_multisports.db
DATABASE_URL=sqlite:./server/database/community_multisports.db

# Authentication & JWT Configuration
JWT_SECRET=super_secret_cryptographic_jwt_key_community_multisports_2026_xyz!
JWT_EXPIRES_IN=7d

# Initial Administrator Bootstrapping Secret
# Required when invoking POST /api/admin/initial-setup to create the first admin
ADMIN_SETUP_SECRET=initial_bootstrap_admin_secret_key_change_me_in_prod_2026!

# Password Setup & Reset Token Lifetime (in hours)
PASSWORD_TOKEN_EXPIRES_HOURS=24
